# ============================================================
# AI Agent 配置 —— 复制为 .env 并填入你的值
# ============================================================

# ── LLM 配置（必填，推荐阿里云 DashScope）──
# 申请: https://dashscope.console.aliyun.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_1=qwen-max
LLM_MODEL_2=qwen-plus
LLM_MODEL_3=qwen-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=60

# ── Redis（核心依赖：记忆/Skill/Mock 数据）──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Agent Server ──
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ── Nacos（可选 —— 留空则不启用服务注册）──
# 配置后 Agent 会注册到 Nacos，便于演示微服务架构
NACOS_SERVER=
NACOS_NAMESPACE=public
NACOS_GROUP=com.social
NACOS_SERVICE_NAME=ai-agent
