<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.social.orderservice.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="com.social.orderservice.domain.po.Order">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="seller_id" property="sellerId"/>
        <result column="quantity" property="quantity"/>
        <result column="total_price" property="totalPrice"/>
        <result column="original_price" property="originalPrice"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="user_coupon_id" property="userCouponId"/>
        <result column="status" property="status"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="receiver_address" property="receiverAddress"/>
        <result column="tracking_number" property="trackingNumber"/>
        <result column="delivery_remark" property="deliveryRemark"/>
        <result column="pay_time" property="payTime"/>
        <result column="delivery_time" property="deliveryTime"/>
        <result column="complete_time" property="completeTime"/>
        <result column="remark" property="remark"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectUserOrderPage" resultMap="OrderResultMap">
        SELECT * FROM "order"
        WHERE is_deleted = 0 AND user_id = #{userId}
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="selectSellerOrderPage" resultMap="OrderResultMap">
        SELECT * FROM "order"
        WHERE is_deleted = 0 AND seller_id = #{sellerId}
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultType="com.social.orderservice.domain.vo.OrderVO">
        SELECT * FROM "order"
        WHERE user_id = #{user_id}
    </select>
</mapper>
